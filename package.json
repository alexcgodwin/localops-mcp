  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alexcgodwin/localops-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/alexcgodwin/localops-mcp/issues"
  },
  "homepage": "https://github.com/alexcgodwin/localops-mcp#readme",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.2.0",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2",
    "vitest": "^5.0.3"
  }
