{
  "name": "opschugex-localops-mcp",
  "version": "0.5.0",
  "description": "OpsChugex LocalOps MCP for local infrastructure, endpoint and systems intelligence on Windows and Linux.",
  "type": "module",
  "mcpName": "io.github.alexcgodwin/localops-mcp",
  "bin": {
    "opschugex-localops-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "server.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "check": "npm run build && npm test && npm audit --omit=dev --audit-level=high"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "local-infrastructure",
    "endpoint",
    "systems",
    "windows",
    "linux",
    "operations",
    "security"
  ],
